{
	"name": "retroix-leaderboard",
	"version": "0.1.0",
	"private": true,
	"description": "One multi-tenant Cloudflare Worker + D1 that backs the high-score leaderboard for all Retroix games.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:create": "wrangler d1 create retroix-leaderboard",
		"db:init": "wrangler d1 execute retroix-leaderboard --remote --file schema.sql",
		"db:init:local": "wrangler d1 execute retroix-leaderboard --local --file schema.sql",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.0.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.0.0"
	}
}
